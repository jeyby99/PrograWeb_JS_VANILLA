# Copy to /opt/prograweb/.env on the test server. Never commit the real file.
# IMAGE_TAG is written by the deploy workflow (e.g. test-sha-1a2b3c4).
IMAGE_TAG=test
DB_USERNAME=postgres
DB_PASSWORD=change-me
# default (good balancer) or bad-balancer (demo); change it with: deploy.sh balancer <good|bad>
GATEWAY_PROFILE=default
